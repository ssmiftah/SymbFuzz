// ---- Clocking --------------------------------------------------------- //

static void clk_posedge() {
    // Single-run rising-edge toggle — matches the xsim TCL bridge.
    top->{{ clock_port }} = 0;
    top->eval();
    top->{{ clock_port }} = 1;
    top->eval();
}

// ---- Wide-value helpers (>64-bit ports) ------------------------------- //

// Parse a JSON value string — either "42" (decimal), "0xdeadbeef" (hex),
// or a quoted "\"0xdeadbeef\"" — into an LSB-first array of 32-bit words.
// Values narrower than the buffer are zero-extended; excess input bits
// beyond `n_words * 32` are silently discarded.
static void parse_value_to_words(const std::string& s_in, uint32_t* words, int n_words) {
    for (int i = 0; i < n_words; ++i) words[i] = 0;
    std::string s = s_in;
    while (!s.empty() && (s.front() == ' ' || s.front() == '\t' ||
                          s.front() == '\n' || s.front() == '\r')) s.erase(s.begin());
    while (!s.empty() && (s.back()  == ' ' || s.back()  == '\t' ||
                          s.back()  == '\n' || s.back()  == '\r')) s.pop_back();
    if (s.size() >= 2 && s.front() == '"' && s.back() == '"') s = s.substr(1, s.size() - 2);
    if (s.empty()) return;
    bool is_hex = (s.size() >= 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'));
    if (is_hex) {
        std::string h = s.substr(2);
        int len = (int)h.size();
        for (int nibble = 0; nibble < len; ++nibble) {
            char c = h[len - 1 - nibble];
            int v = 0;
            if (c >= '0' && c <= '9') v = c - '0';
            else if (c >= 'a' && c <= 'f') v = 10 + (c - 'a');
            else if (c >= 'A' && c <= 'F') v = 10 + (c - 'A');
            else continue;
            int bit_off  = nibble * 4;
            int word_idx = bit_off / 32;
            int bit_idx  = bit_off % 32;
            if (word_idx < n_words) words[word_idx] |= (uint32_t)v << bit_idx;
        }
    } else {
        uint64_t v = 0;
        try { v = std::stoull(s); } catch (...) {}
        if (n_words > 0) words[0] = (uint32_t)(v & 0xFFFFFFFFu);
        if (n_words > 1) words[1] = (uint32_t)(v >> 32);
    }
}

// Parse a JSON value string as a narrow uint64_t.
static uint64_t parse_value_uint64(const std::string& s_in) {
    uint32_t words[2] = {0, 0};
    parse_value_to_words(s_in, words, 2);
    return ((uint64_t)words[1] << 32) | words[0];
}

// Format an LSB-first uint32_t array as a JSON hex-string value:
//   "0xhexdigits"   (with the surrounding quotes)
// `width` is the port's bit width; we emit ceil(width/4) hex digits.
template <typename WideT>
static std::string wide_to_hex_json(const WideT& v, int width) {
    int total = (width + 3) / 4;
    std::string s;
    s.reserve(total + 4);
    s.push_back('"'); s.push_back('0'); s.push_back('x');
    for (int nibble = total - 1; nibble >= 0; --nibble) {
        int bit_off  = nibble * 4;
        int word_idx = bit_off / 32;
        int bit_idx  = bit_off % 32;
        uint32_t w = v[word_idx];
        int nv = (w >> bit_idx) & 0xF;
        s.push_back(nv < 10 ? char('0' + nv) : char('a' + nv - 10));
    }
    s.push_back('"');
    return s;
}

// ---- Input routing ---------------------------------------------------- //

static void set_input(const std::string& name, const std::string& str_val) {
{% for inp in data_inputs %}
{% if inp.width <= 64 %}
    if (name == "{{ inp.name }}") { uint64_t v_ = parse_value_uint64(str_val); top->{{ inp.name }} = (decltype(top->{{ inp.name }}))v_; return; }
{% else %}
    if (name == "{{ inp.name }}") {
        constexpr int N_WORDS = ({{ inp.width }} + 31) / 32;
        uint32_t words[N_WORDS];
        parse_value_to_words(str_val, words, N_WORDS);
        for (int i = 0; i < N_WORDS; ++i) top->{{ inp.name }}[i] = words[i];
        return;
    }
{% endif %}
{% endfor %}
}

static void force_reg(const std::string& name, const std::string& str_val) {
{% for reg in registers %}
{% if reg.width <= 64 %}
    if (name == "{{ reg.arch_name }}") { uint64_t v_ = parse_value_uint64(str_val); top->rootp->{{ module }}__DOT__{{ reg.verilator_path }} = (decltype(top->rootp->{{ module }}__DOT__{{ reg.verilator_path }}))v_; return; }
{% else %}
    if (name == "{{ reg.arch_name }}") {
        constexpr int N_WORDS = ({{ reg.width }} + 31) / 32;
        uint32_t words[N_WORDS];
        parse_value_to_words(str_val, words, N_WORDS);
        for (int i = 0; i < N_WORDS; ++i) top->rootp->{{ module }}__DOT__{{ reg.verilator_path }}[i] = words[i];
        return;
    }
{% endif %}
{% endfor %}
}

// ---- State emission --------------------------------------------------- //

static std::string emit_state_str() {
    std::ostringstream os;
    os << "{";
{% for reg in registers %}
{% if reg.width <= 64 %}
    os << "\"{{ reg.arch_name }}\":" << (uint64_t)(top->rootp->{{ module }}__DOT__{{ reg.verilator_path }}){% if not loop.last %} << ","{% endif %};
{% else %}
    os << "\"{{ reg.arch_name }}\":" << wide_to_hex_json(top->rootp->{{ module }}__DOT__{{ reg.verilator_path }}, {{ reg.width }}){% if not loop.last %} << ","{% endif %};
{% endif %}
{% endfor %}
    os << "}";
    return os.str();
}

// ---- JSON helpers (narrow, for our known message shapes only) --------- //

static int64_t json_get_int(const std::string& s, const std::string& key, int64_t def = -1) {
    std::regex re("\"" + key + "\"\\s*:\\s*(-?\\d+)");
    std::smatch m;
    if (std::regex_search(s, m, re)) return std::stoll(m[1].str());
    return def;
}

// Body of "key":{...} (contents inside the braces, depth-balanced). "" if absent.
static std::string json_get_object(const std::string& s, const std::string& key) {
    std::string pat = "\"" + key + "\"";
    size_t p = s.find(pat);
    if (p == std::string::npos) return "";
    size_t b = s.find('{', p + pat.size());
    if (b == std::string::npos) return "";
    int depth = 1;
    size_t i = b + 1;
    while (i < s.size() && depth > 0) {
        if (s[i] == '{') depth++;
        else if (s[i] == '}') depth--;
        i++;
    }
    if (depth != 0) return "";
    return s.substr(b + 1, i - b - 2);
}

// Body of "key":[...]  (without the outer brackets). "" if absent.
static std::string json_get_array(const std::string& s, const std::string& key) {
    std::string pat = "\"" + key + "\"";
    size_t p = s.find(pat);
    if (p == std::string::npos) return "";
    size_t b = s.find('[', p + pat.size());
    if (b == std::string::npos) return "";
    int depth = 1;
    size_t i = b + 1;
    while (i < s.size() && depth > 0) {
        if (s[i] == '[') depth++;
        else if (s[i] == ']') depth--;
        i++;
    }
    if (depth != 0) return "";
    return s.substr(b + 1, i - b - 2);
}

// Iterate top-level {...} substrings inside a JSON array body.
static std::vector<std::string> json_split_objs(const std::string& body) {
    std::vector<std::string> out;
    size_t i = 0, n = body.size();
    while (i < n) {
        if (body[i] == '{') {
            int depth = 1;
            size_t start = i;
            i++;
            while (i < n && depth > 0) {
                if (body[i] == '{') depth++;
                else if (body[i] == '}') depth--;
                i++;
            }
            out.push_back(body.substr(start, i - start));
        } else {
            i++;
        }
    }
    return out;
}

// Extract "key":value pairs from a JSON object body. Value can be a
// plain integer (narrow: `42`) OR a quoted hex string (wide:
// `"0xdeadbeef"`). Per-port dispatch parses the value string according
// to the port's declared width.
static std::vector<std::pair<std::string, std::string>> json_parse_kv(const std::string& body) {
    std::vector<std::pair<std::string, std::string>> out;
    std::regex re("\"(\\w+)\"\\s*:\\s*(\"[^\"]*\"|-?\\d+)");
    auto begin = std::sregex_iterator(body.begin(), body.end(), re);
    auto end   = std::sregex_iterator();
    for (auto it = begin; it != end; ++it) {
        out.emplace_back((*it)[1].str(), (*it)[2].str());
    }
    return out;
}

// Escape backslashes and double quotes for safe JSON string emission.
static std::string json_escape(const std::string& s) {
    std::string out;
    out.reserve(s.size() + 8);
    for (char c : s) {
        switch (c) {
            case '\\': out += "\\\\"; break;
            case '"':  out += "\\\""; break;
            case '\n': out += "\\n";  break;
            case '\r': out += "\\r";  break;
            case '\t': out += "\\t";  break;
            default:
                if (static_cast<unsigned char>(c) < 0x20) {
                    char buf[8];
                    std::snprintf(buf, sizeof(buf), "\\u%04x", c);
                    out += buf;
                } else {
                    out.push_back(c);
                }
        }
    }
    return out;
}

// ---- Main REPL -------------------------------------------------------- //

int main(int argc, char** argv) {
    ctx = new VerilatedContext;
    ctx->commandArgs(argc, argv);
    top = new V{{ module }}(ctx);

    // Initial idle state — clock low, reset asserted. Matches the xsim
    // bridge initialisation preamble.
    top->{{ clock_port }} = 0;
{% if reset_port %}
    top->{{ reset_port }} = {{ "0" if reset_active_low else "1" }};
{% endif %}
    top->eval();

    std::string line;
    while (std::getline(std::cin, line)) {
        // Order matters: longest command names first so shorter prefixes
        // don't shadow them (step_raw_trace before step_raw before step_trace
        // before step).
        if (line.find("\"cmd\":\"step_raw_trace\"") != std::string::npos) {
            // Raw batch: each dict's inputs drive every port (clock
            // included with the caller-specified polarity), then one
            // eval() per dict. No cycle-wrap — used by BMC replay to
            // honour clk2fflogic's half-cycle semantics.
            std::string body = json_get_array(line, "inputs");
            std::vector<std::string> objs = json_split_objs(body);
            std::ostringstream states;
            states << "[";
            bool first = true;
            std::string err;
            for (const auto& obj : objs) {
                try {
                    for (const auto& kv : json_parse_kv(obj)) {
                        if (kv.first == "{{ clock_port }}") {
                            { uint64_t v_ = parse_value_uint64(kv.second); top->{{ clock_port }} = (decltype(top->{{ clock_port }}))v_; }
                        } else {
                            set_input(kv.first, kv.second);
                        }
                    }
                    top->eval();
                    if (!first) states << ",";
                    states << emit_state_str();
                    first = false;
                } catch (const std::exception& e) {
                    err = e.what();
                    break;
                }
            }
            states << "]";
            if (err.empty()) {
                std::cout << "{\"states\":" << states.str() << "}\n";
            } else {
                std::cout << "{\"states\":" << states.str()
                          << ",\"error\":\"" << json_escape(err) << "\"}\n";
            }
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"step_raw\"") != std::string::npos) {
            std::string inputs = json_get_object(line, "inputs");
            for (const auto& kv : json_parse_kv(inputs)) {
                if (kv.first == "{{ clock_port }}") {
                    top->{{ clock_port }} = (decltype(top->{{ clock_port }}))kv.second;
                } else {
                    set_input(kv.first, kv.second);
                }
            }
            top->eval();
            std::cout << "{\"state\":" << emit_state_str() << "}\n";
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"step_trace\"") != std::string::npos) {
            std::string body = json_get_array(line, "inputs");
            std::vector<std::string> objs = json_split_objs(body);
            std::ostringstream states;
            states << "[";
            bool first = true;
            std::string err;
            for (const auto& obj : objs) {
                try {
                    for (const auto& kv : json_parse_kv(obj)) {
                        set_input(kv.first, kv.second);
                    }
                    clk_posedge();
                    if (!first) states << ",";
                    states << emit_state_str();
                    first = false;
                } catch (const std::exception& e) {
                    err = e.what();
                    break;
                }
            }
            states << "]";
            if (err.empty()) {
                std::cout << "{\"states\":" << states.str() << "}\n";
            } else {
                std::cout << "{\"states\":" << states.str()
                          << ",\"error\":\"" << json_escape(err) << "\"}\n";
            }
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"step\"") != std::string::npos) {
            std::string inputs = json_get_object(line, "inputs");
            for (const auto& kv : json_parse_kv(inputs)) set_input(kv.first, kv.second);
            clk_posedge();
            std::cout << "{\"state\":" << emit_state_str() << "}\n";
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"reset\"") != std::string::npos) {
            int64_t cycles = json_get_int(line, "cycles", 5);
            if (cycles < 0) cycles = 5;
            // Zero all data inputs so lingering values do not bleed through
            // the trailing post-deassertion edge (same fix as tcl_bridge).
{% for inp in data_inputs %}
{% if inp.width <= 64 %}
            top->{{ inp.name }} = 0;
{% else %}
            {
                constexpr int N_WORDS = ({{ inp.width }} + 31) / 32;
                for (int i = 0; i < N_WORDS; ++i) top->{{ inp.name }}[i] = 0;
            }
{% endif %}
{% endfor %}
{% if reset_port %}
            top->{{ reset_port }} = {{ "0" if reset_active_low else "1" }};
{% endif %}
            for (int64_t i = 0; i < cycles; i++) clk_posedge();
{% if reset_port %}
            top->{{ reset_port }} = {{ "1" if reset_active_low else "0" }};
{% endif %}
            clk_posedge();
            std::cout << "{\"ok\":true}\n";
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"read_state\"") != std::string::npos) {
            std::cout << "{\"state\":" << emit_state_str() << "}\n";
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"force\"") != std::string::npos) {
            std::string body = json_get_object(line, "state");
            for (const auto& kv : json_parse_kv(body)) force_reg(kv.first, kv.second);
            std::cout << "{\"ok\":true}\n";
            std::cout.flush();
        }
{% if native_coverage %}
        else if (line.find("\"cmd\":\"coverage\"") != std::string::npos) {
            // Dump current coverage to a .dat file under the working dir,
            // then stream it back as a JSON-escaped string. VerilatedCov
            // accumulates; no reset on read, so successive calls return
            // monotonically growing hit-sets.
            const char* path = "verilator_cov.dat";
            VerilatedCov::write(path);
            std::ifstream f(path);
            std::string body;
            if (f.good()) {
                std::ostringstream ss;
                ss << f.rdbuf();
                body = ss.str();
            }
            std::cout << "{\"report\":\"" << json_escape(body) << "\"}\n";
            std::cout.flush();
        }
{% endif %}
        else if (line.find("\"cmd\":\"checkpoint\"") != std::string::npos) {
            std::cout << "{\"error\":\"checkpoint: unsupported on verilator\"}\n";
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"restore\"") != std::string::npos) {
            std::cout << "{\"error\":\"restore: unsupported on verilator\"}\n";
            std::cout.flush();
        }
        else if (line.find("\"cmd\":\"quit\"") != std::string::npos) {
            break;
        }
    }

    top->final();
    delete top;
    delete ctx;
    return 0;
}
